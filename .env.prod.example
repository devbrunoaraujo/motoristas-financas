# .env.prod.example
#
# Copie este arquivo para .env.prod (que NÃO deve ir pro Git — confirme
# que ele está no .gitignore) e preencha com valores reais.
#
# Diferente do .env de dev, aqui NÃO usamos senhas fracas tipo "root".
# Gere valores fortes, por exemplo com: openssl rand -base64 32

DB_NAME=financas_db
DB_USER=root
DB_PASSWORD=

# Usado para assinar os tokens JWT (HMAC-SHA256). Se vazar, alguém
# consegue forjar tokens de qualquer usuário — trate como segredo
# crítico. Gere com: openssl rand -base64 48
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# URL pública da API que o frontend vai chamar. Em produção real, vai
# ser o domínio/IP do seu servidor (ex: https://api.kmup.com.br),
# não localhost. Lembra: essa variável é "assada" no build do
# frontend, então se ela mudar, é preciso rebuildar a imagem.
VITE_API_URL=http://localhost:8080
