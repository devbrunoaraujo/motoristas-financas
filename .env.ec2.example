# .env.ec2.example
#
# Este é só um MODELO. O arquivo real, com os valores de verdade,
# fica APENAS dentro da EC2 (~/kmup/.env) — nunca é commitado no
# Git nem passa pelo GitHub Actions. Motivo: contém a senha do RDS
# e o segredo do JWT.

# Endpoint do RDS (saída do terraform: rds_endpoint, sem a porta)
DB_HOST=kmup-mysql.c8fo8mqyoti9.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=financas_db
DB_USER=admin
# Mesma senha que está no terraform.tfvars (db_password)
DB_PASSWORD=

# Gere um novo com: openssl rand -base64 48
JWT_SECRET=
