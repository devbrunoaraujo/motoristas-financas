# Copie este arquivo para .env (na mesma pasta) e preencha os valores reais.
# O .env NÃO deve ir para o Git — já está no .gitignore.

# Banco de dados
DB_NAME=financas_db
DB_USER=root
DB_PASSWORD=root

# Segredo usado para assinar os tokens JWT.
# Gere um valor forte (mínimo 32 caracteres) e NUNCA reutilize o de exemplo.
# PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=troque-este-segredo-em-producao-por-uma-chave-forte

# URL que o frontend usa para chamar a API
VITE_API_URL=http://localhost:8080
